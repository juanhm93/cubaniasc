APP_NAME=Cubaniasc
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://cubania.purphura.com/

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@cubaniasc.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (private bucket) for the figure videos. Bucket: cubania-videos-staging.
# R2_ENDPOINT is the account endpoint, without the bucket at the end.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
# Max size of an uploaded figure video, in MB.
CUBANIA_FIGURE_VIDEO_MAX_MB=200

VITE_APP_NAME="${APP_NAME}"

AUTH_REGISTRATION_ENABLED=false
AUTH_LOGIN_VISIBLE=false

CUBANIA_INSTAGRAM_URL=https://www.instagram.com/cubania.sc
CUBANIA_TIKTOK_URL=https://www.tiktok.com/@cubania.sc
CUBANIA_WHATSAPP_URL=https://wa.me/+584122801334
CUBANIA_HERO_YOUTUBE_URL=https://www.youtube.com/watch?v=s4DT0BFxDEk
CUBANIA_HERO_PLAYBACK_RATE=0.75
